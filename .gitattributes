# Normalize all text files to LF so tooling (dart format, cargo fmt,
# flutter gen-l10n) never produces phantom line-ending diffs across
# macOS/Linux/Windows checkouts.
* text=auto eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.moc3 binary
*.zip binary

# Shell scripts need LF even on Windows checkouts.
*.sh text eol=lf

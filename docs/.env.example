# =============================================================================
# Goods4ncu Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Required variables MUST be set before running the application.

# -----------------------------------------------------------------------------
# LLM Configuration (Required: at least one must be set)
# -----------------------------------------------------------------------------

# Google Gemini API Key.
# Required for LLM_PROVIDER=gemini and still required for non-Gemini chat
# providers because Goods4ncu currently uses Gemini embeddings for pgvector/RAG.
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MiniMax API Key (only required if LLM_PROVIDER=minimax)
# MINIMAX_API_KEY=your_minimax_api_key_here

# MiniMax API Base URL (optional, defaults to provider code default)
# MINIMAX_API_BASE_URL=https://api.minimaxi.com/v1

# LLM Provider to use.
# Built-ins: gemini, minimax
# OpenAI-compatible aliases: openai, deepseek, groq, openrouter, xai, together, openai_compatible
# LLM_PROVIDER=gemini

# Chat model name. Required for OpenAI-compatible aliases; optional for gemini/minimax.
# Examples:
#   LLM_PROVIDER=deepseek
#   LLM_MODEL=deepseek-chat
#   DEEPSEEK_API_KEY=your_deepseek_key
#
#   LLM_PROVIDER=groq
#   LLM_MODEL=llama-3.1-8b-instant
#   GROQ_API_KEY=your_groq_key
#
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.example.com/v1
#   LLM_MODEL=provider-model-name
#   LLM_API_KEY=your_provider_key
# LLM_MODEL=gemini-3-flash-preview

# Generic OpenAI-compatible config. Provider-specific keys below take precedence
# only when LLM_API_KEY is not set.
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your_openai_compatible_key
# OPENAI_API_KEY=your_openai_key
# DEEPSEEK_API_KEY=your_deepseek_key
# GROQ_API_KEY=your_groq_key
# OPENROUTER_API_KEY=your_openrouter_key
# XAI_API_KEY=your_xai_key
# TOGETHER_API_KEY=your_together_key

# Embedding vector dimensions (default: 768)
# VECTOR_DIM=768

# -----------------------------------------------------------------------------
# Authentication (Required)
# -----------------------------------------------------------------------------

# JWT secret for token signing - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_here

# Campus email verification delivery webhook.
# Development may omit these values; the backend then writes the one-time code
# to its local log. Production refuses to start unless both are configured.
# The webhook receives JSON with: to, template, code, expires_in_seconds.
# CAMPUS_VERIFICATION_DELIVERY_URL=https://mailer.example.com/internal/send
# CAMPUS_VERIFICATION_DELIVERY_TOKEN=replace_with_a_private_bearer_token

# -----------------------------------------------------------------------------
# Database (Required)
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://user:password@localhost:5432/goods4ncu

# -----------------------------------------------------------------------------
# CORS Configuration (Optional)
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins
# Use "*" to allow all origins (not recommended for production)
# Use "http://localhost:3000" for local development
# In production (`APP_ENV=production` / `ENVIRONMENT=production`), explicit origins are required.
# CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# Optional runtime environment label
# APP_ENV=development

# -----------------------------------------------------------------------------
# Content Moderation (Optional)
# -----------------------------------------------------------------------------

# Comma-separated local policy keywords for content moderation.
# Built-in rules already cover high-risk marketplace categories such as illegal
# goods, adult content, gambling, fraud, violence, harassment, privacy leakage,
# contact info, and external links. Use this variable for campus/local legal
# terms that should not be hard-coded in source.
# BLOCKED_KEYWORDS=本地违规词1,本地违规词2

# -----------------------------------------------------------------------------
# Alibaba Cloud OSS (Optional - for file uploads)
# -----------------------------------------------------------------------------

# OSS endpoint (defaults to Beijing region)
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com

# OSS bucket name (defaults to "goods4ncu")
# OSS_BUCKET=goods4ncu

# RAM Role ARN for STS authentication (optional)
# OSS_ROLE_ARN=acs:ram::123456:role/YourRole

# Access Key credentials (optional - omit if using STS role)
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret

# -----------------------------------------------------------------------------
# Rate Limiting (Optional — defaults to local moka cache, single-node)
# Enable Redis for multi-node horizontal scaling (requires --features redis build)
# -----------------------------------------------------------------------------

# Redis URL for distributed rate limiter (optional — omit for single-node)
# When set, the app uses Redis sorted-set sliding window instead of local moka cache.
# REDIS_URL=redis://localhost:6379

# Maximum requests per IP per window (default: 100)
# RATE_LIMIT_MAX_REQUESTS=100

# Rate limit window in seconds (default: 60)
# RATE_LIMIT_WINDOW_SECS=60

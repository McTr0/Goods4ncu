# =============================================================================
# Goods4ncu Configuration File
# =============================================================================
#
# COPY THIS FILE TO goods4ncu.toml (or config/goods4ncu.toml) AND FILL IN VALUES.
# This file is safe to commit — it contains no secrets.
#
# Env vars ALWAYS override file values. Secrets must come from env vars only.
#
# Config file search order:
#   1. $CONFIG_FILE env var (if set)
#   2. ./goods4ncu.toml (if exists)
#   3. ./config/goods4ncu.toml (if exists)
#   4. ./goods4ncu.toml or ./config/goods4ncu.toml (legacy fallback)
# =============================================================================

# -----------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------
[server]
host = "0.0.0.0"
port = 3000
# Seconds to keep serving after SIGTERM while /api/readyz already reports 503,
# giving the load balancer time to deregister this instance.
shutdown_drain_secs = 5
# Seconds to wait for in-flight requests and workers after the listener closes.
# Keep shutdown_drain_secs + shutdown_timeout_secs below the orchestrator's
# termination grace period, or the process is SIGKILLed mid-drain.
shutdown_timeout_secs = 25

# -----------------------------------------------------------------------
# Chat features
# -----------------------------------------------------------------------
[chat]
# Secret Chat is deprecated; new sessions are refused (403) unless this is
# explicitly set to true for a migration window. History stays readable.
secret_new_sessions_enabled = false

# -----------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------
[llm]
provider = "gemini"          # gemini, minimax, openai, deepseek, groq, openrouter, xai, together, openai_compatible
model = "gemini-3-flash-preview" # Required for OpenAI-compatible providers; optional for gemini/minimax
# base_url = "https://api.deepseek.com/v1" # Optional; useful for openai_compatible/custom gateways
vector_dim = 768             # Embedding vector dimensions
# API keys come from env vars only:
#   GEMINI_API_KEY, MINIMAX_API_KEY
#   LLM_API_KEY or provider-specific keys such as DEEPSEEK_API_KEY/GROQ_API_KEY

# -----------------------------------------------------------------------
# Agent Feature Flag
#
# AGENT_ENABLED=false disables all AI assistant endpoints (SSE chat stream
# returns 503). The rest of the platform operates as the original non-AI demo.
#
# Set via env var: AGENT_ENABLED=false (defaults to true when unset)
# -----------------------------------------------------------------------

# -----------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------
[rate_limit]
max_requests = 100           # Max requests per window per IP
window_secs = 60             # Window duration in seconds
moka_cache_max_capacity = 100_000  # Local cache size for single-node

# Distributed rate limiting via Redis (optional)
# redis_url = "redis://localhost:6379"

# -----------------------------------------------------------------------
# Event Bus
# -----------------------------------------------------------------------
[event_bus]
capacity = 2048              # Bounded channel capacity for backpressure

# -----------------------------------------------------------------------
# Background Workers
# -----------------------------------------------------------------------
[workers.hitl_expire]
scan_interval_secs = 600     # How often to scan for expired negotiations
expire_timeout_hours = 48    # Hours before pending negotiations expire

# -----------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------
[auth]
access_token_ttl_secs = 86400        # 24 hours
refresh_token_ttl_secs = 604800      # 7 days
# Secrets come from env vars: JWT_SECRET

# -----------------------------------------------------------------------
# Marketplace
# -----------------------------------------------------------------------
[marketplace]
conversation_history_limit = 10  # Chat messages in context window
max_keyword_len = 200           # Max keyword search length
price_tolerance = 0.50          # Negotiation price tolerance (0.0–1.0)

categories = [
    "electronics",
    "books",
    "digitalAccessories",
    "dailyGoods",
    "clothingShoes",
    "other",
]

# -----------------------------------------------------------------------
# Content Moderation
# -----------------------------------------------------------------------
# Built-in text rules cover illegal goods, adult content, gambling, fraud,
# violence/extremism, harassment, privacy leakage, contact info, and external
# links. Put campus/local policy keywords in BLOCKED_KEYWORDS when possible
# because environment variables are safer for sensitive rule lists than files.
# If you must list local policy keywords here, keep the file permissions
# restrictive (chmod 600).
[moderation]
# blocked_keywords = ["本地违规词1", "本地违规词2"]

# -----------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------
[cors]
wildcard = false              # Set true to allow all origins (not recommended)
origins = [
    # "https://your-domain.com",
]

# -----------------------------------------------------------------------
# Alibaba Cloud OSS
# -----------------------------------------------------------------------
[oss]
endpoint = "https://oss-cn-beijing.aliyuncs.com"
bucket = "goods4ncu"
# Credentials come from env vars: OSS_ACCESS_KEY_ID, OSS_ACCESS_KEY_SECRET, OSS_ROLE_ARN
